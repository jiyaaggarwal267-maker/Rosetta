# Copy to .env.local. Everything is optional for local development:
# with nothing set, the demo commits still work and data is saved to .data/store.json.

# GitHub: raises the rate limit and is required to post Ask Why comments.
GITHUB_TOKEN=

# Gemini (Google AI Studio free tier)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Fallback model, any OpenAI-compatible API. Groq by default; for OpenRouter use
# FALLBACK_BASE_URL=https://openrouter.ai/api/v1 and an OpenRouter model id.
FALLBACK_API_KEY=
FALLBACK_BASE_URL=https://api.groq.com/openai/v1
FALLBACK_MODEL=openai/gpt-oss-120b

# Free daily limits, so Rosetta stops calling a provider before it starts failing.
# The counter is shown to leads on the Organisation page.
GEMINI_DAILY_LIMIT=20
FALLBACK_DAILY_LIMIT=1000

# Firestore (service account). When unset, the local JSON file store is used.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the key with literal \n for line breaks.
FIREBASE_PRIVATE_KEY=

# Signs login tokens. Required in production; any long random string.
SESSION_SECRET=

# Frontend origins allowed to call this API (comma separated).
ALLOWED_ORIGINS=http://localhost:3000

# Must match the frontend's NEXT_PUBLIC_DEMO_REPO.
DEMO_REPO=code-crunchers/rosetta-demo
MAX_DIFF_LINES=400

# Where the local JSON store lives when Firestore is not configured.
DATA_DIR=

# Email over SMTP. For Gmail: turn on 2-Step Verification, then create an app
# password at myaccount.google.com/apppasswords and paste it as SMTP_PASS.
SMTP_USER=
SMTP_PASS=
# Optional: SMTP_HOST (default smtp.gmail.com), SMTP_PORT (default 465), SMTP_FROM.

# The frontend's address, used for links inside emails.
APP_URL=http://localhost:3000

# Turns on the Monday weekly report email (vercel.json runs /api/cron/weekly).
# Any long random string; Vercel sends it to the job automatically.
CRON_SECRET=

# The pitch commit, which always explains the same way with no GitHub or AI calls.
# PITCH_REPO=vaibhav025/Rosetta-NSUT
# PITCH_SHA=ca08ab4f0a3ecce71292c0be57ccfbd33ff6024e
